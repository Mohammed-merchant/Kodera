# 1. Gnani STT + TTS (English + Hindi + Gujarati)
GNANI_API_KEY=put_your_gnani_key_here
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGES=gu-IN,hi-IN,en-IN
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# 2. Groq LLM
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=put_your_free_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile

STT_BASE_URL=http://127.0.0.1:8002/v1
TTS_BASE_URL=http://127.0.0.1:8003/v1
