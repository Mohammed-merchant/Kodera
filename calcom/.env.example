# Cal.diy settings. Copy to calcom/.env (./deploy.sh init does that and makes the secrets).
# Never commit calcom/.env.

# Where Cal.diy is reached by the public: its own hostname (needs a DNS A record to this server).
CAL_DOMAIN=cal.example.com
CAL_PUBLIC_URL=https://cal.example.com

# Images built by the "Build Cal.diy images" GitHub Action (see README.md).
# GitHub user names must be lowercase here.
CAL_WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/calcom-diy-web:latest
CAL_API_IMAGE=ghcr.io/YOUR_GITHUB_USER/calcom-diy-api:latest

# Secrets (./deploy.sh init generates these).
CAL_DB_PASSWORD=
NEXTAUTH_SECRET=
CALENDSO_ENCRYPTION_KEY=
JWT_SECRET=

# Memory limits. Raise them if you see out-of-memory kills in `./deploy.sh status`.
CAL_WEB_MEMORY=1536m
CAL_API_MEMORY=768m

# Optional: email (booking confirmations to patients/staff). Leave empty to send none.
EMAIL_FROM=notifications@example.com
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
