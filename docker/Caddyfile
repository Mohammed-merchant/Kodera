# DOMAIN comes from the environment (set in .env, passed by docker-compose).
# Caddy gets and renews a Let's Encrypt certificate for it automatically
# (needs the DNS A record to point here and ports 80/443 open).

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Carrier media streams (wss://DOMAIN/ws/...). Caddy upgrades WebSocket
	# connections automatically; no timeouts so long calls are not cut off.
	handle /ws/* {
		reverse_proxy app:8000
	}

	handle {
		reverse_proxy app:8000
	}

	log {
		output stdout
		format json
	}
}

# Extra sites (for example Cal.diy: calcom/deploy.sh writes docker/conf.d/calcom.caddy).
# Nothing here when no extra site is set up.
import /etc/caddy/conf.d/*.caddy
