# Copy to .env and fill in real values. Never commit .env.
# On the server: cp .env.example .env && chmod 600 .env && nano .env

# docker-compose.prod.yml forces APP_ENV=production on the server.
APP_ENV=local
LOG_LEVEL=INFO
# Must be https://<DOMAIN> in production (no trailing slash).
PUBLIC_BASE_URL=https://calls.example.com

# Inside Docker Compose the hosts are "postgres" and "redis".
# The password here MUST match POSTGRES_PASSWORD below. Use URL-safe characters
# only (letters and digits, e.g. from: openssl rand -hex 24).
DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/app
REDIS_URL=redis://redis:6379/0

TELNYX_API_KEY=replace-me
TELNYX_PUBLIC_KEY=replace-me
TELNYX_CONNECTION_ID=replace-me

# OpenAI-compatible endpoints on the separate GPU server.
LLM_BASE_URL=http://gpu-server.example.internal:8001/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
STT_BASE_URL=http://gpu-server.example.internal:8002/v1
TTS_BASE_URL=http://gpu-server.example.internal:8003/v1

GATEWAY_API_KEY=replace-me

# Used by docker-compose only (not read by the app).
# DOMAIN: public hostname with a DNS A record pointing at the server. Caddy
# requests the HTTPS certificate for it. Required.
DOMAIN=calls.example.com
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
