# Copy to .env and fill in real values. Never commit .env.
# On the server: cp .env.example .env && chmod 600 .env && nano .env

# docker-compose.prod.yml forces APP_ENV=production on the server.
APP_ENV=local
LOG_LEVEL=INFO
# Must be https://<DOMAIN> in production (no trailing slash).
PUBLIC_BASE_URL=https://calls.example.com

# Inside Docker Compose the hosts are "postgres" and "redis".
# The password here MUST match POSTGRES_PASSWORD below. Use URL-safe characters
# only (letters and digits, e.g. from: openssl rand -hex 24).
DATABASE_URL=postgresql+asyncpg://app:change-me@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# Which carrier is active: "exotel" or "twilio". Only that carrier's routes answer.
CALL_PROVIDER=exotel

# Exotel: dashboard > Settings > API Settings. See docs/exotel.md.
EXOTEL_API_KEY=replace-me
EXOTEL_API_TOKEN=replace-me
EXOTEL_ACCOUNT_SID=replace-me
EXOTEL_PHONE_NUMBER=+910000000000
# Random secret for the Passthru URL (?token=...). Make one: openssl rand -hex 24
EXOTEL_WEBHOOK_SECRET=replace-me
# Optional: comma-separated Exotel source IPs (ask Exotel support). Empty = no IP check.
EXOTEL_ALLOWED_IPS=

# Twilio (only used when CALL_PROVIDER=twilio): Console > Account Info. Phone number in E.164 format, e.g. +15551234567.
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=+15550000000

TELNYX_API_KEY=replace-me
TELNYX_PUBLIC_KEY=replace-me
TELNYX_CONNECTION_ID=replace-me

# OpenAI-compatible endpoints on the separate GPU server.
LLM_BASE_URL=http://gpu-server.example.internal:8001/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
STT_BASE_URL=http://gpu-server.example.internal:8002/v1
TTS_BASE_URL=http://gpu-server.example.internal:8003/v1

GATEWAY_API_KEY=replace-me

# Used by docker-compose only (not read by the app).
# DOMAIN: public hostname with a DNS A record pointing at the server. Caddy
# requests the HTTPS certificate for it. Required.
DOMAIN=calls.example.com
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# ---- Clinic (the voice agent is this clinic's phone receptionist). Edit these. ----
CLINIC_NAME=City Care Clinic
CLINIC_DOCTOR=Dr. Sharma
CLINIC_ADDRESS=12 Main Road, near the bus stand
CLINIC_FEES=500 rupees for a consultation
# Open days: 0 = Monday ... 6 = Sunday
CLINIC_OPEN_DAYS=0,1,2,3,4,5
# Consultation sessions (24-hour HH:MM-HH:MM, comma separated)
CLINIC_SESSIONS=10:00-13:00,17:00-20:00
CLINIC_SLOT_MINUTES=15
# Clinic clock: minutes ahead of UTC (India = 330)
CLINIC_UTC_OFFSET_MINUTES=330
AGENT_NAME=Kodera

# ---- Staff dashboard at /dashboard (bookings, calls, database performance) ----
# Leave empty to switch it off. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(12))"
DASHBOARD_PASSWORD=

# ---- Appointments: "local" (built-in table) or "calcom" (self-hosted Cal.diy, see calcom/README.md) ----
BOOKING_BACKEND=local
# Only used with BOOKING_BACKEND=calcom:
CAL_API_URL=http://calcom-api:80
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_WEBHOOK_SECRET=
CAL_PUBLIC_URL=
CLINIC_TIMEZONE_NAME=Asia/Kolkata
CLINIC_PHONE_COUNTRY_CODE=+91
CAL_BOOKING_PAGE=
