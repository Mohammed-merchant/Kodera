# Copy to model_server/.env on the GPU machine. Never commit the real .env.

# One shared key for all three servers. The app sends it as "Authorization: Bearer <key>".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MODEL_SERVER_API_KEY=
BIND_HOST=127.0.0.1
GATEWAY_PORT=8000   # ngrok http 8000 exposes LLM+STT+TTS on one URL
PRELOAD=true

# ---- LLM: llama.cpp llama-server (port 8001) ----
LLAMA_SERVER_BIN=llama-server
# Path to the Qwen GGUF file.
#  4 GB GPU (RTX 3050): Qwen2.5-3B-Instruct Q4_K_M  (~2.0 GB)
#  8 GB GPU (RTX 5060): Qwen2.5-7B-Instruct Q4_K_M  (~4.7 GB)
LLM_GGUF=./models/qwen2.5-3b-instruct-q4_k_m.gguf
LLM_ALIAS=qwen
LLM_PORT=8001
# Using Ollama instead of llama-server? Set LLM_PORT=11434, then run:  python run_all.py stt tts gateway
# (and once: ollama cp qwen2.5:3b-instruct-q4_K_M qwen   so the model is called "qwen")
LLM_CTX=2048
# 99 = put every layer on the GPU. Lower it if you run out of VRAM.
LLM_GPU_LAYERS=99

# ---- STT: faster-whisper (port 8002) ----
STT_PORT=8002
WHISPER_MODEL=small
# On a 4 GB GPU, use "base" with WHISPER_DEVICE=cpu, or keep "small" on cuda if the LLM leaves room.
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# empty = auto-detect (en, hi, ...)
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=3
# Topic hint used when the app sends none (the app sends its own clinic-specific one).
WHISPER_PROMPT=Clinic appointment booking. Times like 11:15 AM and 5:30 PM. Dates like Thursday 12 November.
MAX_UPLOAD_MB=25

# ---- TTS: Piper (port 8003, runs on CPU, no VRAM) ----
TTS_PORT=8003
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_DIR=./models/piper

# ---- Extra settings (used by the Linux bootstrap and the laptop scripts) ----
# Calls the LLM answers at once. LLM_CTX is shared between them (2 calls x 4096 = 8192).
LLM_PARALLEL=1
# Extra folders with CUDA libraries for llama-server (Linux), separated by ":"
LLM_LIB_DIRS=
# The tunnel address that gpu_server.ps1 / bootstrap_e2e.sh open
NGROK_URL=https://compel-dissuade-subheader.ngrok-free.dev
# Safety guard: stop everything above these limits (laptop 83, datacentre GPU 85)
GPU_MAX_TEMP_C=83
GPU_MAX_MEM_PERCENT=92
